# Database Credentials (REQUIRED - no defaults)
DB_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_USER=postgres

# Database Names (Optional - defaults provided)
MYSQL_DATABASE=bookstore_catalog
POSTGRES_DATABASE=bookstore_users
MONGO_DATABASE=bookstore_orders

# JWT Secret (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=

# CORS Origins
CORS_ALLOWED_ORIGIN=http://localhost:4200
CORS_ADMIN_ORIGIN=http://localhost:8084

# Optional: NVD API Key for dependency scanning
# Obtain from: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
