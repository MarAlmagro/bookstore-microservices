# Database Credentials
DB_USER=root
DB_PASSWORD=password

# MySQL (Catalog Service)
MYSQL_DATABASE=bookstore_catalog
MYSQL_PORT=3306

# MongoDB (Order Service)
MONGO_DATABASE=bookstore_orders
MONGO_PORT=27017

# PostgreSQL (User Service)
POSTGRES_DATABASE=bookstore_users
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Service Ports
CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
USER_SERVICE_PORT=8083

# Supabase Configuration (User Service - Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Test Credentials (Created by initialization scripts in scripts/ directory)
# These accounts are automatically created when starting the Docker containers

# Admin Account
# Email: admin@bookstore.com
# Password: admin123
# Role: ADMIN
# Use for: Managing books, viewing all orders, administrative tasks

