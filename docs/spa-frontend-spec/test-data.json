  "apiEndpoints": {
    "baseUrl": "http://localhost:8080",
    "auth": {
      "login": "POST /api/v1/auth/login",
      "register": "POST /api/v1/auth/register",
      "refresh": "POST /api/v1/auth/refresh"
    },
    "books": {
      "list": "GET /api/v1/books",
      "listPaginated": "GET /api/v1/books/page",
      "getById": "GET /api/v1/books/{id}",
      "getByIsbn": "GET /api/v1/books/isbn/{isbn}",
      "search": "GET /api/v1/books/search?query={query}",
      "byCategory": "GET /api/v1/books/category/{category}",
      "byAuthor": "GET /api/v1/books/author/{author}",
      "available": "GET /api/v1/books/available",
      "create": "POST /api/v1/books",
      "update": "PUT /api/v1/books/{id}",
      "delete": "DELETE /api/v1/books/{id}",
      "updateStock": "PATCH /api/v1/books/{id}/stock?quantity={qty}"
    },
    "orders": {
      "create": "POST /api/v1/orders",
      "getById": "GET /api/v1/orders/{id}",
      "listAll": "GET /api/v1/orders",
      "listPaginated": "GET /api/v1/orders/page",
      "byUser": "GET /api/v1/orders/user/{userId}",
      "byStatus": "GET /api/v1/orders/status/{status}",
      "updateStatus": "PUT /api/v1/orders/{id}/status?status={status}",
      "delete": "DELETE /api/v1/orders/{id}"
    },
    "users": {
      "profile": "GET /api/v1/users/profile",
      "updateProfile": "PUT /api/v1/users/profile",
      "getById": "GET /api/v1/users/{id}",
      "delete": "DELETE /api/v1/users/{id}"
    }
